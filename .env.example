# ============================================================
# 环境变量示例文件（仅占位符，绝无真实 Key）
# 使用方式：复制本文件为 .env，再填入真实值。
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 安全红线：
#   - 真实 .env 不得提交到版本控制或写入脚本；
#   - 脚本只通过 python-dotenv 从环境变量只读加载，禁止硬编码。
# ============================================================

# 美国能源信息署（EIA）公开数据 API Key
EIA_API_KEY=

# 欧盟天然气基础设施（GIE AGSI）储气数据 API Key（作为 TTF 代理）
GIE_AGSI_API_KEY=

# ---- 别名（与上面等价，便于按用户文档 EIA_KEY / GIE_AGSI_KEY 读取）----
EIA_KEY=
GIE_AGSI_KEY=
